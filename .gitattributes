# Auto detect text files and normalize line endings in the repository
* text=auto

# Binary assets
*.mp3 binary
*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.ttc binary
*.otf binary
*.woff binary
*.woff2 binary

# 윈도우 배치 파일은 CRLF로 내려받아야 cmd가 라벨과 한글을 바르게 읽는다.
shorts*.bat text eol=crlf
schedule_shorts.bat text eol=crlf
